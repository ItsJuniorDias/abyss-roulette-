# Public runtime profile: local demo credits only.
VITE_SESSION_PROFILE=demo

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# optional
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Videos use heygen/heygen-video-1. Keep the key on this machine, never in VITE_*.
OPENROUTER_VIDEO_RESOLUTION=768p
# Optional public origin serving public/. If blank, use tmp/tunnel/active.json.
OPENROUTER_ASSET_BASE_URL=
